%% ---------- Hyperref (last) ---------------------------------------
\RequirePackage[colorlinks=true,linkcolor=fshfaccent,urlcolor=fshfaccent,
                citecolor=fshfaccent,pdfborder={0 0 0}]{hyperref}
\urlstyle{same}

