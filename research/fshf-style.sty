%% ===================================================================
%% fshf-style.sty -- FS Student Hedge Fund house style for research papers
%% Target: pdfLaTeX, twice-compiled, A4, \documentclass[11pt,a4paper]{article}
%% Fonts: Times (newtx if available on the distribution, mathptmx fallback)
%% ===================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fshf-style}[2026/07/23 v1.0 FSHF research paper house style]

%% ---------- Encoding and base fonts -------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{textcomp}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
%% Times New Roman family. newtx is the full modern Times implementation
%% shipped with current TeX Live; mathptmx is the universally available
%% fallback so the file compiles even on minimal installations.
\IfFileExists{newtxtext.sty}{%
  \RequirePackage{newtxtext}%
  \IfFileExists{newtxmath.sty}{\RequirePackage{newtxmath}}{}%
}{%
  \RequirePackage{mathptmx}%
}
\IfFileExists{microtype.sty}{\RequirePackage{microtype}}{}

%% ---------- Page geometry -----------------------------------------
\RequirePackage[a4paper,top=27mm,bottom=27mm,left=25mm,right=25mm,
                headheight=14pt,headsep=8mm,footskip=12mm]{geometry}
\RequirePackage{setspace}
\setstretch{1.12}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.55\baselineskip}
\RequirePackage{enumitem}
\setlist{topsep=2pt,itemsep=2pt,parsep=0pt,leftmargin=1.6em}

%% ---------- Colors: one accent, used sparingly --------------------
\RequirePackage{xcolor}
\definecolor{fshfaccent}{RGB}{16,44,84}   % deep navy
\definecolor{fshfrule}{RGB}{16,44,84}
\definecolor{fshfgray}{RGB}{90,90,90}

%% ---------- Section styling ---------------------------------------
\RequirePackage{titlesec}
\setcounter{secnumdepth}{4}
\titleformat{\section}
  {\normalfont\large\bfseries\color{fshfaccent}}
  {\thesection.}{0.6em}{}
\titlespacing*{\section}{0pt}{1.4\baselineskip}{0.5\baselineskip}
\titleformat{\subsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{1.1\baselineskip}{0.3\baselineskip}
\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries}
  {\thesubsubsection}{0.6em}{}
\titlespacing*{\subsubsection}{0pt}{0.9\baselineskip}{0.25\baselineskip}
%% Fourth level (used by the Fixed Income paper, e.g. 2.3.2.1) as a
%% numbered display heading rather than a run-in paragraph.
\titleformat{\paragraph}
  {\normalfont\normalsize\itshape\bfseries}
  {\theparagraph}{0.6em}{}
\titlespacing*{\paragraph}{0pt}{0.8\baselineskip}{0.2\baselineskip}
\renewcommand{\theparagraph}{\thesubsubsection.\arabic{paragraph}}

%% ---------- Header / footer ---------------------------------------
\RequirePackage{fancyhdr}
\newcommand{\fshfshorttitle}{}
\newcommand{\SetFshfShortTitle}[1]{\renewcommand{\fshfshorttitle}{#1}}
\fancypagestyle{fshf}{%
  \fancyhf{}%
  \fancyhead[L]{\small\itshape FS Student Hedge Fund}%
  \fancyhead[R]{\small\itshape \fshfshorttitle}%
  \fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \renewcommand{\headrule}{\color{fshfrule}\hrule width\headwidth height\headrulewidth}%
  \renewcommand{\footrulewidth}{0pt}%
}
\fancypagestyle{plain}{% first pages of ToC etc.
  \fancyhf{}\fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}
\pagestyle{fshf}

%% ---------- Tables -------------------------------------------------
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{makecell}
\renewcommand{\arraystretch}{1.22}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}       % wrapped left col
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}        % wrapped right col
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{Q}[1]{>{\raggedleft\arraybackslash}p{#1}}
%% Bold sentence-case table headers:
\newcommand{\thead@font}{\bfseries}
\newcommand{\tabh}[1]{{\bfseries #1}}
%% Source / footnote line under a table or figure:
\newcommand{\fshfsource}[1]{\par\vspace{2pt}{\footnotesize\color{fshfgray}#1\par}}

%% ---------- Captions ----------------------------------------------
\RequirePackage{caption}
%% Uniform heading rule (Jakob, Jul 2026): table and figure headings are set
%% flush left at the text margin, never centred, across all papers.
\captionsetup{labelfont={bf,small},textfont={small},labelsep=colon,skip=4pt,%
  justification=raggedright,singlelinecheck=false}
\captionsetup[table]{position=above,skip=6pt}
\captionsetup[figure]{position=below}
%% longtable caption spacing consistent with table captions
\setlength{\LTpre}{0.8\baselineskip}
\setlength{\LTpost}{0.6\baselineskip}

%% ---------- Figures (guarded includes) ----------------------------
\RequirePackage{graphicx}
%% \fshffig{filename-without-path}{caption text}{source line (may be empty)}
%% Includes figures/<filename> at a uniform width; if the file is absent
%% the document still compiles, showing a labelled placeholder box.
\newcommand{\fshffig}[3]{%
  \begin{figure}[htbp]
    \centering
    \IfFileExists{figures/#1}%
      {\includegraphics[width=0.85\linewidth]{figures/#1}}%
      {\fbox{\parbox[c][0.32\linewidth][c]{0.8\linewidth}{\centering
        \small\color{fshfgray}Figure placeholder\\[2pt]\texttt{figures/#1}\\[2pt]
        (drop the exported image into /figures)}}}%
    \caption{#2}%
    \ifx\relax#3\relax\else\fshfsource{#3}\fi
  \end{figure}}

%% ---------- Title page ("Deckblatt") ------------------------------
%% \makefshftitle{Title}{Asset class / subtitle}{Authors}{Date}{As-of note or \relax}
\newcommand{\makefshftitle}[5]{%
  \begin{titlepage}
    \thispagestyle{empty}
    \centering
    \vspace*{8mm}
    \IfFileExists{figures/fshf-logo.png}%
      {\includegraphics[height=22mm]{figures/fshf-logo.png}\par\vspace{10mm}}%
      {\vspace{10mm}}%
    {\color{fshfaccent}\rule{\linewidth}{0.9pt}}\par\vspace{9mm}
    {\LARGE\bfseries #1\par}
    \vspace{4mm}
    {\large\itshape #2\par}
    \vspace{9mm}
    {\color{fshfaccent}\rule{\linewidth}{0.9pt}}\par
    \vfill
    {\normalsize Submitted to\par\vspace{1.5mm}
     {\bfseries Francesco di Fano}\par
     {\itshape Head of FS Student Hedge Fund}\par}
    \vspace{9mm}
    {\normalsize Prepared by\par\vspace{1.5mm}
     {\bfseries #3}\par}
    \vspace{9mm}
    {\normalsize #4\par}
    \ifx\relax#5\relax\else\vspace{5mm}{\small\color{fshfgray}#5\par}\fi
    \vspace{9mm}
    {\small FS Student Hedge Fund\par}
    \vspace*{6mm}
  \end{titlepage}
  \setcounter{page}{2}}

%% ---------- Reference list (manual hanging indent, no biblatex) ----
\newenvironment{fshfreferences}
  {\section*{References}\small
   \begin{list}{}{\setlength{\leftmargin}{1.8em}\setlength{\itemindent}{-1.8em}%
     \setlength{\itemsep}{2pt}\setlength{\parsep}{0pt}}}
  {\end{list}}
%% Unnumbered variant heading for papers that title the list differently:
\newenvironment{fshfreferences*}[1]
  {\section*{#1}\small
   \begin{list}{}{\setlength{\leftmargin}{1.8em}\setlength{\itemindent}{-1.8em}%
     \setlength{\itemsep}{2pt}\setlength{\parsep}{0pt}}}
  {\end{list}}

